VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_ASSETS_BUCKET=spread-assets

# LLM provider keys are entered at runtime via the Settings (🔑) modal in
# the app — they live in localStorage, not in this file. The three vars
# below exist only as a DEV-ONLY fallback so you can `npm run dev` without
# clicking through the modal first. In production builds, leave them
# unset; the app will prompt the user on first generator run.
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_GEMINI_API_KEY=...
# VITE_GROK_API_KEY=xai-...
